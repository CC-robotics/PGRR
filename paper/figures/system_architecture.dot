digraph RAMPArchitecture {
  graph [rankdir=TB, bgcolor="white", pad="0.12", nodesep="0.35", ranksep="0.35",
         fontname="Helvetica", fontsize=10, splines=polyline];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9,
        color="#52616B", fillcolor="#F5F7F8", penwidth=1.1, margin="0.10,0.06"];
  edge [fontname="Helvetica", fontsize=8, color="#52616B", arrowsize=0.65, penwidth=1.0];

  env [label="Dynamic environment\n+ robot", fillcolor="#EAF2F8"];
  obs [label="Observable state\n5-frame LiDAR, path, goal,\nvelocity, planner status", fillcolor="#EAF2F8"];
  detector [label="Rule failure detector\ncollision / freeze /\noscillation / deadlock", fillcolor="#FFF4E6", color="#D97706"];
  gate [shape=diamond, label="failure\ntrigger?", fillcolor="#FFF4E6", color="#D97706", margin="0.05"];
  planner [label="Classical Nav2 planner\nDWB + global path", fillcolor="#EAF2F8"];
  mask [label="Planning + safety mask\npath corridor, swept LiDAR,\ncollision latch", fillcolor="#E8F6F3", color="#16836B"];
  policy [label="DAgger recovery policy\n25 interpretable actions", fillcolor="#E8F6F3", color="#16836B"];
  mux [label="Goal mux\ntemporary subgoal / WAIT /\nBACKUP / REPLAN / CONTINUE", fillcolor="#E8F6F3", color="#16836B"];

  { rank=same; env; obs; detector; gate; }
  { rank=same; mask; policy; mux; planner; }

  env -> obs [label="sensors"];
  obs -> detector;
  detector -> gate;
  gate -> planner [label="no: original goal", minlen=2];
  gate -> mask [label="yes"];
  obs -> policy;
  mask -> policy [label="valid actions"];
  policy -> mux;
  mux -> planner [label="bounded option"];
  planner -> env [label="velocity command"];
  env -> detector [label="closed-loop feedback", constraint=false, color="#16836B"];

  subgraph cluster_training {
    label="Training only";
    color="#AAB7B8";
    style="rounded,dashed";
    fontname="Helvetica";
    fontsize=9;
    truth [label="Privileged simulator state", fillcolor="#F5F7F8"];
    expert [label="Short-horizon planning expert\nroll out masked candidates", fillcolor="#F5F7F8"];
    dagger [label="BC + two DAgger rounds", fillcolor="#F5F7F8"];
    { rank=same; truth; expert; dagger; }
    truth -> expert;
    expert -> dagger [label="actions + costs"];
    dagger -> policy [label="export ONNX", style=dashed, color="#16836B"];
  }
}
